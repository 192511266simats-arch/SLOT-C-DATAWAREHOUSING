data <- c(11,13,13,15,15,16,19,20,
          20,20,21,21,22,23,24,30,
          40,45,45,45,71,72,73,75)

# Divide data into 3 equal-frequency bins
bins <- split(data, rep(1:3, each = 8))

# Smoothing by Bin Mean
cat("Smoothing by Bin Mean:\n")
mean_smooth <- lapply(bins, function(x) {
  rep(mean(x), length(x))
})
print(mean_smooth)

# Smoothing by Bin Median
cat("Smoothing by Bin Median:\n")
median_smooth <- lapply(bins, function(x) {
  rep(median(x), length(x))
})
print(median_smooth)

# Smoothing by Bin Boundaries
cat("Smoothing by Bin Boundaries:\n")
boundary_smooth <- lapply(bins, function(x) {
  sapply(x, function(v) {
    if (abs(v-min(x)) <= abs(v-max(x)))
      min(x)
    else
      max(x)
  })
})
print(boundary_smooth)
