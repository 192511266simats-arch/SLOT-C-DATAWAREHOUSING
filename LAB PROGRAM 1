age <- c("1-5", "5-15", "15-20", "20-50", "50-80", "80-110")
freq <- c(200, 450, 300, 1500, 700, 44)

cf <- cumsum(freq)
N <- sum(freq)

i <- which(cf >= N/2)[1]

L <- c(1, 5, 15, 20, 50, 80)[i]
h <- c(4, 10, 5, 30, 30, 30)[i]
f <- freq[i]
F <- ifelse(i == 1, 0, cf[i-1])

median <- L + ((N/2 - F)/f) * h

cat("Approximate Median =", median)
