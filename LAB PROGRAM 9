marks <- c(55, 60, 71, 63, 55, 65, 50, 55,
           58, 59, 61, 63, 65, 67, 71, 72, 75)

# Sort the data
marks <- sort(marks)

# Equal-Frequency Partitioning
equal_frequency <- split(
  marks,
  cut(seq_along(marks), breaks=3, labels=FALSE)
)

cat("Equal-Frequency Partitioning:\n")
print(equal_frequency)

# Equal-Width Partitioning
equal_width <- split(
  marks,
  cut(marks, breaks=3, include.lowest=TRUE)
)

cat("Equal-Width Partitioning:\n")
print(equal_width)

# Histogram
hist(marks,
     main="Histogram of Student Marks",
     xlab="Marks",
     col="lightblue",
     border="black")
