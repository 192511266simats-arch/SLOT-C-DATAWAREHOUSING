data <- read.csv("diabetes.csv")

data <- subset(data, BloodPressure > 0)

plot(data$Age,data$BloodPressure,
     main="Blood Pressure vs Age",
     xlab="Age",
     ylab="Blood Pressure",
     pch=19,col="blue")

data$AgeGroup <- cut(
  data$Age,
  breaks=c(0,30,40,50,60,Inf)
)

avg <- tapply(data$BloodPressure,
              data$AgeGroup,mean)

barplot(avg,
        main="Average BP by Age Group",
        xlab="Age Group",
        ylab="Average Blood Pressure",
        col="orange")

print(avg)
