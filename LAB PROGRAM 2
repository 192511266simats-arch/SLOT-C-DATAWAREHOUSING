age <- c(13, 15, 16, 16, 19, 20, 20, 21, 22,
         22, 25, 25, 25, 25, 30, 33, 33, 35,
         35, 35, 35, 36, 40, 45, 46, 52, 70)

get_mode <- function(x) {
  t <- table(x)
  as.numeric(names(t)[t == max(t)])
}

cat("Mean =", mean(age), "\n")
cat("Median =", median(age), "\n")
cat("Mode =", get_mode(age), "\n")
cat("Midrange =", (min(age) + max(age))/2, "\n")
cat("First Quartile =", quantile(age, 0.25), "\n")
cat("Third Quartile =", quantile(age, 0.75), "\n")
